generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Authentication ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// ─── Broker Profile ───────────────────────────────────────────────────────────

model BrokerProfile {
  id              String   @id @default(cuid())
  name            String
  title           String
  tagline         String
  bio             String   @db.Text
  shortBio        String   @db.Text
  philosophy      String   @db.Text
  photo           String
  photoAlt        String   @default("")
  email           String
  phone           String
  licenseNumber   String   @default("")
  serviceAreas    String[] @default([])
  yearsExperience Int      @default(0)
  salesVolume     String   @default("")
  transactions    Int      @default(0)
  areasServed     Int      @default(0)
  instagram       String   @default("")
  linkedin        String   @default("")
  facebook        String   @default("")
  twitter         String   @default("")
  youtube         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("broker_profiles")
}

// ─── Site Settings ────────────────────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Properties ───────────────────────────────────────────────────────────────

model Property {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String          @db.Text
  price           Float
  status          PropertyStatus  @default(FOR_SALE)
  address         String
  city            String
  state           String
  zip             String
  bedrooms        Int
  bathrooms       Float
  squareFeet      Int
  lotSize         Float?
  yearBuilt       Int?
  propertyType    PropertyType    @default(SINGLE_FAMILY)
  amenities       String[]        @default([])
  videoUrl        String?
  virtualTourUrl  String?
  latitude        Float?
  longitude       Float?
  listingDate     DateTime        @default(now())
  soldDate        DateTime?
  soldPrice       Float?
  neighborhoodId  String?
  featured        Boolean         @default(false)
  signature       Boolean         @default(false)
  representedAs   RepresentationType @default(SELLERS_AGENT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  images      PropertyImage[]
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  @@index([status])
  @@index([featured])
  @@index([slug])
  @@index([city])
  @@index([price])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String   @default("")
  order      Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

enum PropertyStatus {
  FOR_SALE
  JUST_LISTED
  UNDER_CONTRACT
  SOLD
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOUSE
  MULTI_FAMILY
  LAND
  COMMERCIAL
  LUXURY_ESTATE
  PENTHOUSE
}

enum RepresentationType {
  BUYERS_AGENT
  SELLERS_AGENT
  DUAL_AGENT
}

// ─── Neighborhoods ────────────────────────────────────────────────────────────

model Neighborhood {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  heroImage     String
  description   String   @db.Text
  lifestyle     String   @db.Text
  marketOverview String  @db.Text
  highlights    String[] @default([])
  latitude      Float?
  longitude     Float?
  seoTitle      String   @default("")
  seoDescription String  @default("")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties Property[]

  @@index([slug])
  @@map("neighborhoods")
}

// ─── Testimonials ─────────────────────────────────────────────────────────────

model Testimonial {
  id              String   @id @default(cuid())
  clientName      String
  review          String   @db.Text
  rating          Int      @default(5)
  transactionType String
  location        String   @default("")
  propertyAddress String   @default("")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("testimonials")
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id                String     @id @default(cuid())
  name              String
  email             String
  phone             String     @default("")
  interest          LeadInterest
  propertyId        String?
  propertyAddress   String     @default("")
  message           String     @db.Text @default("")
  preferredContact  String     @default("email")
  status            LeadStatus @default(NEW)
  source            String     @default("website")
  notes             String     @db.Text @default("")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([email])
  @@map("leads")
}

enum LeadInterest {
  BUYING
  SELLING
  VALUATION
  GENERAL
  CONSULTATION
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  ARCHIVED
}

// ─── Blog / Insights ──────────────────────────────────────────────────────────

model Insight {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String        @db.Text
  content       String        @db.Text
  coverImage    String
  categoryId    String?
  tags          String[]      @default([])
  author        String        @default("Alexandra Voss")
  publishedAt   DateTime?
  featured      Boolean       @default(false)
  status        InsightStatus @default(DRAFT)
  readTime      Int           @default(5)
  seoTitle      String        @default("")
  seoDescription String       @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@map("insights")
}

enum InsightStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())

  insights Insight[]

  @@map("categories")
}

// ─── Media / Press ────────────────────────────────────────────────────────────

model MediaMention {
  id          String   @id @default(cuid())
  publication String
  title       String
  url         String
  date        DateTime
  logo        String   @default("")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media_mentions")
}

// ─── Awards ───────────────────────────────────────────────────────────────────

model Award {
  id          String   @id @default(cuid())
  title       String
  issuer      String
  year        Int
  description String   @default("")
  icon        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("awards")
}

// ─── Newsletter ───────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}
